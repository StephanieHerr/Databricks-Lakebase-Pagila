table "public"."address" {
  primaryKey = {
    columns = [
      "address_id"
    ]
    name = "address_pkey"
    objectType = primaryKey
  }
  owner = stephanie.herr@red-gate.com
  privileges = <
    {
      grantee = "stephanie.herr@red-gate.com"
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = app_user
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
      ]
    }

    {
      grantee = databricks_gateway
      privilegeTypes = [
        SELECT
      ]
    }

    {
      grantee = databricks_superuser
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = databricks_reader_16403
      privilegeTypes = [
        SELECT
      ]
    }

  >
  columns = (
    column "address_id" {
      type = integer
      null = NOT NULL
      generatedAsIdentity = BY DEFAULT
    }
    column "address" {
      type = character varying(50)
      null = NOT NULL
    }
    column "address2" {
      type = character varying(50)
    }
    column "district" {
      type = character varying(20)
      null = NOT NULL
    }
    column "city_id" {
      type = integer
      null = NOT NULL
    }
    column "postal_code" {
      type = character varying(10)
    }
    column "phone" {
      type = character varying(20)
      null = NOT NULL
    }
    column "last_update" {
      type = timestamp with time zone
      null = NOT NULL
      default = now()
    }
  )
}

foreignKey "public"."address"."address_city_id_fkey" {
  columns = [
    "city_id"
  ]
  referencedTable = "public"."city"
  referencedColumns = [
    "city_id"
  ]
  onUpdate = CASCADE
  onDelete = RESTRICT
}

