table "public"."customer" {
  primaryKey = {
    columns = [
      "customer_id"
    ]
    name = "customer_pkey"
    objectType = primaryKey
  }
  owner = stephanie.herr@red-gate.com
  privileges = <
    {
      grantee = "stephanie.herr@red-gate.com"
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = app_user
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
      ]
    }

    {
      grantee = databricks_gateway
      privilegeTypes = [
        SELECT
      ]
    }

    {
      grantee = databricks_superuser
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = databricks_reader_16403
      privilegeTypes = [
        SELECT
      ]
    }

  >
  columns = (
    column "customer_id" {
      type = integer
      null = NOT NULL
      generatedAsIdentity = BY DEFAULT
    }
    column "store_id" {
      type = integer
      null = NOT NULL
    }
    column "first_name" {
      type = character varying(45)
      null = NOT NULL
    }
    column "last_name" {
      type = character varying(45)
      null = NOT NULL
    }
    column "email" {
      type = character varying(50)
    }
    column "address_id" {
      type = integer
      null = NOT NULL
    }
    column "activebool" {
      type = boolean
      null = NOT NULL
      default = true
    }
    column "create_date" {
      type = date
      null = NOT NULL
      default = """-
('now'::text)::date
"""
    }
    column "last_update" {
      type = timestamp with time zone
      default = now()
    }
    column "active" {
      type = integer
    }
  )
}

foreignKey "public"."customer"."customer_address_id_fkey" {
  columns = [
    "address_id"
  ]
  referencedTable = "public"."address"
  referencedColumns = [
    "address_id"
  ]
  onUpdate = CASCADE
  onDelete = RESTRICT
}

foreignKey "public"."customer"."customer_store_id_fkey" {
  columns = [
    "store_id"
  ]
  referencedTable = "public"."store"
  referencedColumns = [
    "store_id"
  ]
  onUpdate = CASCADE
  onDelete = RESTRICT
}

