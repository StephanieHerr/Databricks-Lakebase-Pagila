table "public"."actor" {
  primaryKey = {
    columns = [
      "actor_id"
    ]
    name = "actor_pkey"
    objectType = primaryKey
  }
  owner = stephanie.herr@red-gate.com
  privileges = <
    {
      grantee = "stephanie.herr@red-gate.com"
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = app_user
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
      ]
    }

    {
      grantee = databricks_gateway
      privilegeTypes = [
        SELECT
      ]
    }

    {
      grantee = databricks_superuser
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = databricks_reader_16403
      privilegeTypes = [
        SELECT
      ]
    }

  >
  columns = (
    column "actor_id" {
      type = integer
      null = NOT NULL
      generatedAsIdentity = BY DEFAULT
    }
    column "first_name" {
      type = character varying(45)
      null = NOT NULL
    }
    column "last_name" {
      type = character varying(45)
      null = NOT NULL
    }
    column "last_update" {
      type = timestamp with time zone
      null = NOT NULL
      default = now()
    }
  )
}

