table "public"."city" {
  primaryKey = {
    columns = [
      "city_id"
    ]
    name = "city_pkey"
    objectType = primaryKey
  }
  owner = stephanie.herr@red-gate.com
  privileges = <
    {
      grantee = "stephanie.herr@red-gate.com"
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = app_user
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
      ]
    }

    {
      grantee = databricks_gateway
      privilegeTypes = [
        SELECT
      ]
    }

    {
      grantee = databricks_superuser
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = databricks_reader_16403
      privilegeTypes = [
        SELECT
      ]
    }

  >
  columns = (
    column "city_id" {
      type = integer
      null = NOT NULL
      generatedAsIdentity = BY DEFAULT
    }
    column "city" {
      type = character varying(50)
      null = NOT NULL
    }
    column "country_id" {
      type = integer
      null = NOT NULL
    }
    column "last_update" {
      type = timestamp with time zone
      null = NOT NULL
      default = now()
    }
  )
}

foreignKey "public"."city"."city_country_id_fkey" {
  columns = [
    "country_id"
  ]
  referencedTable = "public"."country"
  referencedColumns = [
    "country_id"
  ]
  onUpdate = CASCADE
  onDelete = RESTRICT
}

