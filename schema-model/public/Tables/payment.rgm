table "public"."payment" {
  primaryKey = {
    columns = [
      "payment_id"
    ]
    name = "payment_pkey"
    objectType = primaryKey
  }
  owner = stephanie.herr@red-gate.com
  privileges = <
    {
      grantee = "stephanie.herr@red-gate.com"
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = app_user
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
      ]
    }

    {
      grantee = databricks_gateway
      privilegeTypes = [
        SELECT
      ]
    }

    {
      grantee = databricks_superuser
      privilegeTypes = [
        INSERT
        SELECT
        UPDATE
        DELETE
        TRUNCATE
        REFERENCES
        TRIGGER
        MAINTAIN
      ]
    }

    {
      grantee = databricks_reader_16403
      privilegeTypes = [
        SELECT
      ]
    }

  >
  columns = (
    column "payment_id" {
      type = integer
      null = NOT NULL
      generatedAsIdentity = BY DEFAULT
    }
    column "customer_id" {
      type = integer
      null = NOT NULL
    }
    column "staff_id" {
      type = integer
      null = NOT NULL
    }
    column "rental_id" {
      type = integer
      null = NOT NULL
    }
    column "amount" {
      type = numeric(5,2)
      null = NOT NULL
    }
    column "payment_date" {
      type = timestamp with time zone
      null = NOT NULL
    }
  )
}

foreignKey "public"."payment"."payment_customer_id_fkey" {
  columns = [
    "customer_id"
  ]
  referencedTable = "public"."customer"
  referencedColumns = [
    "customer_id"
  ]
  onUpdate = CASCADE
  onDelete = RESTRICT
}

foreignKey "public"."payment"."payment_rental_id_fkey" {
  columns = [
    "rental_id"
  ]
  referencedTable = "public"."rental"
  referencedColumns = [
    "rental_id"
  ]
  onUpdate = CASCADE
  onDelete = SET NULL
}

foreignKey "public"."payment"."payment_staff_id_fkey" {
  columns = [
    "staff_id"
  ]
  referencedTable = "public"."staff"
  referencedColumns = [
    "staff_id"
  ]
  onUpdate = CASCADE
  onDelete = RESTRICT
}

